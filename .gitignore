# This research workspace contains many unrelated scripts and generated runs.
# Keep the initial FF-Decomposition release intentionally allowlisted.
/*
!/.gitattributes
!/.gitignore
!/pyproject.toml
!/requirements.txt
!/decomposition_core.py
!/MLPBenchmarkSuite.py
!/BroadMLPBenchmarkScheduler.py
!/MatchedLocalityControlScheduler.py
!/MatchedCELocalityControlScheduler.py
!/NormalizationAblationScheduler.py
!/LocalBPCNNBenchmark.py
!/MatchedCNNLocalBPBenchmarkScheduler.py
!/MLPMixerBenchmarkSuite.py
!/ReducedMixerBenchmarkScheduler.py
!/medmnist_support.py
!/ReconstructionProbe.py
!/ReconstructionExperimentScheduler.py
!/tests/
!/tests/**

# Python, build, and editor state inside the released directories.
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
build/
dist/
*.egg-info/
.idea/
.vscode/

# Datasets, checkpoints, logs, and generated experiment artifacts.
data/
results/
tmp*/
lightning_logs/
*.ckpt
*.log
*.pt
*.pth
*.csv
*.pdf
*.png
*.tif
*.tiff
